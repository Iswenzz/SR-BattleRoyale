#!/bin/bash
export NAME=sr_battleroyale
SCRIPTS=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
export GAME=$(realpath "$SCRIPTS/../../..")
export MOD="$GAME/mods/$NAME"
export SR="$MOD/sr"

case "$(uname -s)" in
	Linux)
		export BIN_PREFIX=""
		export BIN_START="wine"
	;;
	CYGWIN*|MSYS*|MINGW*)
		export BIN_PREFIX=".exe"
		export BIN_START="start"
	;;
esac
