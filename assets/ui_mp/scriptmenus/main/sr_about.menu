// About pages: a striped contents list down the left with every chapter one click away, the page beside it.
#include "ui/components/base.inc"

#define ABOUT_TEXT_COLOR	0.85 0.85 0.85 1
#define ABOUT_HOVER(pid)	(localVarInt(ui_about_hover) == pid)
#define ABOUT_ROW_Y(pk)		(84 + ((pk) - 1) * 34)

#define ABOUT_TITLE_1		"Welcome"
#define ABOUT_TITLE_2		"Commands"
#define ABOUT_TITLE_3		"IW3SR"
#define ABOUT_TITLE_4		"Open Source"
#define ABOUT_TITLE_5		"Community"

#define ABOUT_FILL(px, py, pw, ph, pcolor) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_FILLED \
		backcolor		pcolor \
		visible			1 \
		decoration \
	}

#define ABOUT_FILL_IF(px, py, pw, ph, pcolor, pcond) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		style			WINDOW_STYLE_FILLED \
		backcolor		pcolor \
		visible			when(pcond) \
		decoration \
	}

#define ABOUT_LABEL(px, py, pw, ph, ptext, pscale, palign, pcolor) \
	itemDef \
	{ \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		type			ITEM_TYPE_TEXT \
		text			ptext \
		textfont		UI_FONT_NORMAL \
		textscale		pscale \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		palign \
		forecolor		pcolor \
		visible			1 \
		decoration \
	}

// The page text keeps its own line breaks, so it is not wrapped: py is the first line's baseline and
// lines are 14.4 apart. The longest lines need about 380 of width at this scale.
#define ABOUT_BODY(px, py, pbody) \
	itemDef \
	{ \
		rect			px py 384 230 SR_ALIGN_TOP_SUBLEFT \
		type			ITEM_TYPE_TEXT \
		text			pbody \
		textfont		UI_FONT_NORMAL \
		textscale		0.3 \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		ITEM_ALIGN_LEFT \
		forecolor		ABOUT_TEXT_COLOR \
		visible			1 \
		decoration \
	}

// Clickable part of a page link. pid lights the ABOUT_HOVER items drawn under it, unique in the page.
#define ABOUT_HIT(pid, px, py, pw, ph, plabel, palign, palignx, ptarget, pcond) \
	itemDef \
	{ \
		type			ITEM_TYPE_BUTTON \
		rect			px py pw ph SR_ALIGN_TOP_SUBLEFT \
		text			plabel \
		textfont		UI_FONT_NORMAL \
		textscale		0.26 \
		textstyle		ITEM_TEXTSTYLE_SHADOWED \
		textalign		palign \
		textalignx		palignx \
		forecolor		1 1 1 1 \
		visible			when(pcond) \
		onFocus \
		{ \
			play "mouse_over"; \
			setLocalVarInt ui_about_hover pid; \
		} \
		leaveFocus \
		{ \
			setLocalVarInt ui_about_hover 0; \
		} \
		action \
		{ \
			play "mouse_click"; \
			close self; \
			open ptarget; \
		} \
	}

// pk is the chapter listed, ppage the page drawing the list; both are plain numbers.
#define ABOUT_CHAPTER(pk, ptitle, ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 154, 34, 0.5 0.1 1 0.55, pk == ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 3, 34, 0 1 1 1, pk == ppage) \
	ABOUT_FILL_IF(38, ABOUT_ROW_Y(pk), 154, 34, 0 1 1 0.14, ABOUT_HOVER(pk)) \
	ABOUT_LABEL(44, ABOUT_ROW_Y(pk), 20, 34, #pk, 0.26, ITEM_ALIGN_MIDDLE_RIGHT, ABOUT_TEXT_COLOR) \
	ABOUT_HIT(pk, 38, ABOUT_ROW_Y(pk), 154, 34, ptitle, ITEM_ALIGN_MIDDLE_LEFT, 34, about_page_##pk, 1)

// Previous or next. Like the original, the first page's previous and the last page's next reopen it.
#define ABOUT_STEP(pid, px, plabel, ptarget) \
	ABOUT_FILL(px, 364, 100, 26, 0.5 0.1 1 0.45) \
	ABOUT_FILL_IF(px, 364, 100, 26, 0 1 1 0.2, ABOUT_HOVER(pid)) \
	ABOUT_HIT(pid, px, 364, 100, 26, plabel, ITEM_ALIGN_MIDDLE_CENTER, 0, ptarget, 1)

#define ABOUT_PAGE(ppage, pprev, pnext, ptitle, pbody) \
	menuDef \
	{ \
		name			"about_page_" ## #ppage \
		rect			0 0 640 480 HORIZONTAL_ALIGN_SUBLEFT VERTICAL_ALIGN_SUBTOP \
		focusColor		0 1 1 1 \
		onOpen \
		{ \
			setLocalVarInt ui_about_hover 0; \
		} \
		onEsc \
		{ \
			close self; \
		} \
		itemDef \
		{ \
			name			"window" \
			rect			30 50 580 350 SR_ALIGN_TOP_SUBLEFT \
			style			WINDOW_STYLE_FILLED \
			backcolor		0 0 0 0.6 \
			border			WINDOW_BORDER_FULL \
			bordersize		1 \
			bordercolor		0.5 0.1 1 0.6 \
			visible			1 \
			decoration \
		} \
		ABOUT_FILL(31, 51, 168, 348, 0 0 0 0.35) \
		ABOUT_FILL(199, 51, 2, 348, 0.5 0.1 1 0.8) \
		ABOUT_LABEL(44, 52, 140, 30, "Contents", 0.24, ITEM_ALIGN_MIDDLE_LEFT, ABOUT_TEXT_COLOR) \
		ABOUT_FILL(38, 84, 154, 170, 0 0 0 0.3) \
		ABOUT_FILL(38, ABOUT_ROW_Y(2), 154, 34, 1 1 1 0.04) \
		ABOUT_FILL(38, ABOUT_ROW_Y(4), 154, 34, 1 1 1 0.04) \
		ABOUT_CHAPTER(1, ABOUT_TITLE_1, ppage) \
		ABOUT_CHAPTER(2, ABOUT_TITLE_2, ppage) \
		ABOUT_CHAPTER(3, ABOUT_TITLE_3, ppage) \
		ABOUT_CHAPTER(4, ABOUT_TITLE_4, ppage) \
		ABOUT_CHAPTER(5, ABOUT_TITLE_5, ppage) \
		ABOUT_LABEL(216, 52, 380, 36, ptitle, 0.42, ITEM_ALIGN_MIDDLE_LEFT, 1 1 1 1) \
		ABOUT_FILL(216, 90, 380, 2, 0.5 0.1 1 1) \
		ABOUT_BODY(216, 116, pbody) \
		ABOUT_STEP(11, 216, "< Previous", about_page_##pprev) \
		ABOUT_LABEL(316, 364, 180, 26, #ppage ## " / 5", 0.26, ITEM_ALIGN_MIDDLE_CENTER, ABOUT_TEXT_COLOR) \
		ABOUT_STEP(12, 496, "Next >", about_page_##pnext) \
		execKeyInt 13 \
		{ \
			scriptmenuresponse "enter"; \
		} \
		execKeyInt 32 \
		{ \
			scriptmenuresponse "space"; \
		} \
	}

{
	ABOUT_PAGE(1, 1, 2, ABOUT_TITLE_1, "^7Welcome to ^5SR BattleRoyale^7, a first-person survival mod for ^5Call of Duty 4^7\ndrawing inspiration from ^5H1Z1^7, ^5PUBG^7, and ^5Fortnite^7.\n\n^7Every match begins aboard a ^5plane^7. Choose your drop point and parachute\ndown into the map. Once on the ground, scavenge for ^5weapons^7 and ^5gear^7,\ngrenades, smokes, flashbangs, ^5med kits^7, and bandages are scattered\nacross the map. Find equipment fast or you won't last long.\n\n^7After some time, an ^5objective point^7 appears on the minimap, which can\nalso be opened as a ^5full-screen map^7 to plan your next move.\n\n^7The ^5safe zone^7 progressively closes in, staying outside it will drain\nyour health. Adapt, reposition, outlast everyone else.\n\n^7The ^5last player standing^7 wins.")
	ABOUT_PAGE(2, 1, 3, ABOUT_TITLE_2, "^7A large set of commands is available to all players at any time.\nType ^2!help^7 in chat to browse the full list. Here are the most useful ones:\n\n^2!pm ^7Send a private message directly to another player on the server.\n^2!graphics ^7Re-enable common graphics settings if they were disabled.\n^2!fps ^7Toggle fullbright mode for improved frame rate.\n^2!fov ^7Adjust your field of view to your preference.\n^2!video ^7Request a video to be played on the in-game screen.")
	ABOUT_PAGE(3, 2, 4, ABOUT_TITLE_3, "^5IW3SR^7 is a custom CoD4 client.\nStrongly recommended for all players and essential for the smoothest\nexperience on custom movement modes like Q3, Q3CPM, CS, and Portal.\n\n^5Velocity meter: ^7Real-time velocity display showing your exact speed at\n^7all times, essential for learning and optimizing movement.\n^5CGAZ: ^7Visualizes strafe zones on screen, showing the optimal angle\n^7window to maximize acceleration during every airborne moment.\n^5Bhop script: ^7Optimized bunny hop input handling built directly into\n^7the client for consistent jumps without timing variance.\n^5KMOV: ^7Fully customizable dynamic HUD displays for movement data.\n^5Built-in browser: ^7Watch videos in-game without alt-tabbing.\n\n^7Download and source available at ^2github.com/Iswenzz/IW3SR")
	ABOUT_PAGE(4, 3, 5, ABOUT_TITLE_4, "^7The entire SR project is open source and community maintained.\nEvery part of the server, client, and tooling is publicly available\nfor anyone to explore, learn from, or contribute to.\n\n^7The full codebase is hosted on GitHub. You can browse the source,\nopen issues, suggest features, or submit pull requests directly at\n^2github.com/Iswenzz\n\n^7Contributions of all kinds are welcome and appreciated.\n^7The project grows because of the community. If you have skills\nand want to contribute, the door is open.")
	ABOUT_PAGE(5, 4, 5, ABOUT_TITLE_5, "^7An active community of players, speedrunners, and mappers is\nalways online. Whether you are looking for help, want to share a run,\nor just want to follow the latest updates, come join us.\n\nThe ^5Discord^7 is the heart of the community. It is the best place\nto ask questions, get feedbacks, report bugs, and stay up to date with every\nnew map release, mode update, and server announcement.\n\n^5Website: ^2sr-speedrun.com\n^5Discord: ^2discord.gg/76aHfGF\n^5GitHub: ^2github.com/Iswenzz")
}
