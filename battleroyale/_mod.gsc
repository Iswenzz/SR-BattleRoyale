main()
{
	precache();
	precacheFx();

	battleroyale\sys\_dvar::main();

	maps\mp\gametypes\_hud::init();
	maps\mp\gametypes\_hud_message::init();
	maps\mp\gametypes\_damagefeedback::init();
	maps\mp\gametypes\_clientids::init();
	maps\mp\gametypes\_gameobjects::init();
	maps\mp\gametypes\_gameobjects::main([]);
	maps\mp\gametypes\_spawnlogic::init();
	maps\mp\gametypes\_oldschool::deletePickups();
	maps\mp\gametypes\_quickmessages::init();
	maps\mp\gametypes\_weapons::init();

	sr\_mod::main();
	sr\commands\_admin::main();
	sr\commands\_cef::main();
	sr\commands\_debug::main();
	sr\commands\_graphics::main();
	sr\commands\_map::main();
	sr\commands\_misc::main();
	sr\commands\_music::main();
	sr\commands\_player::main();
	sr\commands\_vote::main();
	sr\core\_demo::main();
	sr\core\_killcam::main();
	sr\core\_modes::main();
	sr\core\_music::main();
	sr\core\_noclip::main();
	sr\core\_overlays::main();
	sr\core\_perks::main();
	sr\core\_poll::main();
	sr\core\_rank::main();
	sr\core\_time::main();
	sr\core\_vote::main();
	sr\fx\_shaders::main();
	sr\huds\_crosshair::main();
	sr\huds\_hitmarker::main();
	sr\huds\_notifications::main();
	sr\huds\_voice::main();
	sr\modes\_debug::main();

	battleroyale\core\_bots::main();
	battleroyale\core\_game::main();
	battleroyale\core\_map::main();
	battleroyale\core\_match::main();
	battleroyale\core\_plane::main();
	battleroyale\core\_settings::main();
	battleroyale\core\_weapons::main();
	battleroyale\core\_zone::main();
	battleroyale\huds\_health::main();
	battleroyale\huds\_hint::main();
	battleroyale\huds\_info::main();
	battleroyale\huds\_inventory::main();
	battleroyale\huds\_loading::main();
	battleroyale\huds\_zone::main();
	battleroyale\menus\_main::main();
	battleroyale\sys\_scoreboard::main();
}

